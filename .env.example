# ============================================================
# Burnout League — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000
JWT_SECRET=change-me-in-production-min-32-chars
SESSION_SECRET=change-me-in-production-min-32-chars

# ── Database (PostgreSQL via Railway) ────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/burnout_dev

# ── Redis (Railway) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MySportsFeeds ────────────────────────────────────────────
# API key goes in Railway environment variables, not committed here
# Set the real value in the Railway dashboard only. Never put it in this file.
MSF_API_KEY=
MSF_API_PASSWORD=MYSPORTSFEEDS
MSF_BASE_URL=https://api.mysportsfeeds.com/v2.1/feed
MSF_SEASON=2026-2027-regular

# ── Stripe ───────────────────────────────────────────────────
# Use test keys for dev; live keys set only in Railway production env
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ── Cloudflare ───────────────────────────────────────────────
# Used for image optimization / CDN edge rules if needed
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Notifications ────────────────────────────────────────────
# SendGrid for transactional email
SENDGRID_API_KEY=SG.

# Expo push notifications (set after EAS project created)
EXPO_ACCESS_TOKEN=

# ── NTP / Clock ──────────────────────────────────────────────
# Server clock is authoritative — NTP synced. No client override.
TZ=America/New_York
