# ============================================================
# Burnout League — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# PRD-006: base URL for email links and checkout return URLs
APP_BASE_URL=http://localhost:3000
CURRENT_SEASON=2026-2027-regular
# Comma-separated browser origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000
# false only for local http development; production cookies are Secure
SESSION_COOKIE_SECURE=false
# Proxies in front of the API for req.ip (Railway's edge = 1)
TRUST_PROXY=1
# PRD-006 §10.4: Cloudflare adds this value as the X-Burnout-Edge header on
# every proxied request (Transform Rule). Only requests carrying it may use the
# cf-* location and client-IP headers. Unset in production = checkout blocked.
# Leave unset locally. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EDGE_SHARED_SECRET=
# 32 random bytes, base64. Encrypts TOTP secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it invalidates every enrolled authenticator.
TOTP_ENCRYPTION_KEY=

# ── Database (PostgreSQL via Railway) ────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/burnout_dev

# ── Redis (Railway) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MySportsFeeds ────────────────────────────────────────────
# API key goes in Railway environment variables, not committed here
# Set the real value in the Railway dashboard only. Never put it in this file.
MSF_API_KEY=
MSF_API_PASSWORD=MYSPORTSFEEDS
MSF_BASE_URL=https://api.mysportsfeeds.com/v2.1/pull/nfl
MSF_SEASON=2026-2027-regular

# ── Payments (PRD-004) ───────────────────────────────────────
# No live processor until written approval is recorded (PRD-004 §7.3).
# The fake processor signs webhooks with this secret.
PAYMENT_WEBHOOK_SECRET=change-me
PAYMENTS_LIVE=false

# ── Cloudflare ───────────────────────────────────────────────
# Used for image optimization / CDN edge rules if needed
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Notifications ────────────────────────────────────────────
# SendGrid for transactional email
SENDGRID_API_KEY=
MAIL_FROM=no-reply@burnoutfantasy.com

# Expo push notifications (set after EAS project created)
EXPO_ACCESS_TOKEN=

# ── NTP / Clock ──────────────────────────────────────────────
# Server clock is authoritative — NTP synced. No client override.
TZ=America/New_York
