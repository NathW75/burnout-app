{
  "name": "@burnout/web",
  "version": "0.1.0",
  "private": true,
  "description": "Burnout League web app (PRD-007)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:staging": "tsc -p tsconfig.json --noEmit && vite build --mode staging",
    "build:production": "tsc -p tsconfig.json --noEmit && vite build --mode production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "express": "^4.22.3",
    "ioredis": "^5.11.1",
    "jsdom": "^27.4.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.40.0"
  }
}
