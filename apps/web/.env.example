# Build-time settings for the web app (PRD-007 §4). Public values only:
# everything here ends up in the browser bundle. Never put a secret here.
VITE_API_BASE_URL=http://localhost:3001
# Cloudflare Turnstile site key. Leave empty locally (no widget; the API skips
# the check when it has no secret). Cloudflare's always-pass test key is
# 1x00000000000000000000AA if you want to see the widget.
VITE_TURNSTILE_SITE_KEY=
