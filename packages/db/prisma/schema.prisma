// Burnout League — Prisma Schema
// PRD-001: Burn Engine tables
// Extend with PRD-002 (Scoring), PRD-003 (Leaderboard), PRD-004 (Payments)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  handle          String?   @db.VarChar(20)     // public identity (PRD-003 §7); unique case-insensitively via migration
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  poolEntries         PoolEntry[]
  seasonSubmissions   SeasonSubmission[]
  weeklySubmissions   WeeklySubmission[]
  burnRecords         BurnRecord[]
  submissionReceipts  SubmissionReceipt[]
  weekScores          UserWeekScore[]
  contestEntries      ContestEntry[]
  handleHistory       UserHandleHistory[]
  leaderboardRows     LeaderboardSnapshot[]
  entryIntents        EntryIntent[]
  refunds             Refund[]
  payouts             Payout[]
  payoutAccount       PayoutAccount?
  accountHolds        AccountHold[]
  identityChecks      IdentityVerification[]

  @@map("users")
}

// ── Player Pool ───────────────────────────────────────────────────────────────

model PoolEntry {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  playerId  String    @map("player_id") @db.VarChar(50)
  season    String    @db.VarChar(20)
  burned    Boolean   @default(false)
  burnedAt  DateTime? @map("burned_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user        User         @relation(fields: [userId], references: [id])
  burnRecords BurnRecord[]

  @@unique([userId, playerId, season])
  @@index([userId, season, burned], name: "idx_pool_entries_user_season")
  @@map("pool_entries")
}

// ── Game Windows ──────────────────────────────────────────────────────────────

model GameWindow {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  week           Int       @db.SmallInt
  season         String    @db.VarChar(20)
  label          String    @db.VarChar(50)
  scheduledEt    DateTime  @map("scheduled_et") @db.Timestamptz  // lock fires at this time; actual kickoff irrelevant
  status         String    @default("pending") @db.VarChar(20)
  msfGameIds     String[]  @default([]) @map("msf_game_ids")
  finalPostedAt  DateTime? @map("final_posted_at") @db.Timestamptz

  seasonSubmissions  SeasonSubmission[]
  weeklySubmissions  WeeklySubmission[]
  burnRecords        BurnRecord[]
  lockEvents         LockEvent[]
  nflGames           NflGame[]
  playerGameStats    PlayerGameStats[]
  playerGameScores   PlayerGameScore[]

  @@index([status, scheduledEt], name: "idx_game_windows_status")
  @@map("game_windows")
}

// ── Season-long Submissions ───────────────────────────────────────────────────

model SeasonSubmission {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  week          Int       @db.SmallInt
  season        String    @db.VarChar(20)
  slotKey       String    @map("slot_key") @db.VarChar(10)
  playerId      String    @map("player_id") @db.VarChar(50)
  gameWindowId  String    @map("game_window_id") @db.Uuid
  submittedAt   DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz  // null = not yet locked
  voidReason    String?   @map("void_reason") @db.VarChar(50) // GAME_CANCELED | ADMIN_VOID

  user          User         @relation(fields: [userId], references: [id])
  gameWindow    GameWindow   @relation(fields: [gameWindowId], references: [id])
  burnRecords   BurnRecord[]

  @@unique([userId, week, season, slotKey])
  @@index([gameWindowId, lockedAt], name: "idx_season_submissions_window")
  @@map("season_submissions")
}

// ── Burn Records (write-once; immutable) ─────────────────────────────────────

model BurnRecord {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  playerId      String   @map("player_id") @db.VarChar(50)
  season        String   @db.VarChar(20)
  week          Int      @db.SmallInt
  gameWindowId  String   @map("game_window_id") @db.Uuid
  submissionId  String   @map("submission_id") @db.Uuid
  lockedAt      DateTime @map("locked_at") @db.Timestamptz
  burnedAt      DateTime @default(now()) @map("burned_at") @db.Timestamptz

  user        User             @relation(fields: [userId], references: [id])
  poolEntry   PoolEntry        @relation(fields: [userId, playerId, season], references: [userId, playerId, season])
  gameWindow  GameWindow       @relation(fields: [gameWindowId], references: [id])
  submission  SeasonSubmission @relation(fields: [submissionId], references: [id])

  // One burn per player per season per user — enforced at DB level
  @@unique([userId, playerId, season])
  @@map("burn_records")
}

// ── Lock Events (audit) ───────────────────────────────────────────────────────

model LockEvent {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameWindowId        String   @map("game_window_id") @db.Uuid
  firedAt             DateTime @default(now()) @map("fired_at") @db.Timestamptz
  submissionsLocked   Int      @map("submissions_locked")
  notificationsQueued Int      @map("notifications_queued")

  gameWindow GameWindow @relation(fields: [gameWindowId], references: [id])

  @@map("lock_events")
}

// ── Security Audit Log (slot reopen events) ───────────────────────────────────

model SecurityAuditLog {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType              String   @map("event_type") @db.VarChar(50)
  gameId                 String?  @map("game_id") @db.Uuid
  userId                 String?  @map("user_id") @db.Uuid
  slotKey                String?  @map("slot_key") @db.VarChar(10)
  authorizationReference String?  @map("authorization_reference") @db.VarChar(255)
  performedBy            String   @map("performed_by") @db.Uuid
  performedAt            DateTime @default(now()) @map("performed_at") @db.Timestamptz
  metadata               Json?

  @@map("security_audit_log")
}

// ── Submission Receipts (three-gate confirmation; dispute resolution) ─────────

model SubmissionReceipt {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  week            Int      @db.SmallInt
  season          String   @db.VarChar(20)
  lineupSnapshot  Json     @map("lineup_snapshot")  // complete 9-slot snapshot at Gate 3
  gate1At         DateTime @map("gate1_at") @db.Timestamptz
  gate2At         DateTime @map("gate2_at") @db.Timestamptz
  gate3At         DateTime @map("gate3_at") @db.Timestamptz
  ipAddress       String   @map("ip_address") @db.VarChar(45)
  userAgent       String   @map("user_agent")
  submissionId    String   @map("submission_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@map("submission_receipts")
}

// ── Weekly Contest Submissions (burn isolation — separate table) ──────────────

model WeeklySubmission {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  contestId     String    @map("contest_id") @db.Uuid
  week          Int       @db.SmallInt
  season        String    @db.VarChar(20)
  slotKey       String    @map("slot_key") @db.VarChar(10)
  playerId      String    @map("player_id") @db.VarChar(50)
  gameWindowId  String    @map("game_window_id") @db.Uuid
  submittedAt   DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz
  // NOTE: WeeklySubmission NEVER references burn_records or pool_entries.
  // Burn isolation is architectural. A player in a weekly contest is NEVER burned
  // from the season-long pool as a result of that weekly submission.

  user       User       @relation(fields: [userId], references: [id])
  gameWindow GameWindow @relation(fields: [gameWindowId], references: [id])

  @@unique([userId, contestId, slotKey])
  @@map("weekly_submissions")
}

// ── Notification Queue (transactional outbox; PRD-001 §4.4, §8, AC7) ─────────
// Rows are written INSIDE the lock / burn / reopen transaction. A dispatcher in
// @burnout/api reads rows with dispatched_at IS NULL after commit and delivers
// them (Expo push, in-app badge, email). If the transaction rolls back, the rows
// never exist, so there are no orphaned notifications.

model NotificationQueue {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  kind          String    @db.VarChar(30)   // LOCK | BURN | SLOT_REOPENED
  gameWindowId  String?   @map("game_window_id") @db.Uuid
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz

  @@index([dispatchedAt, createdAt], name: "idx_notification_queue_pending")
  @@map("notification_queue")
}

// ═════════════════════════════════════════════════════════════════════════════
// PRD-002 — Scoring Engine
// ═════════════════════════════════════════════════════════════════════════════

// Per-game status from the MSF schedule feed. Freeze timing (PRD-002 §7) runs
// off final_observed_at: the server time at which ingestion first saw Final.
model NflGame {
  msfGameId        String    @id @map("msf_game_id") @db.VarChar(50)
  season           String    @db.VarChar(20)
  week             Int       @db.SmallInt
  gameWindowId     String?   @map("game_window_id") @db.Uuid
  scheduledStart   DateTime  @map("scheduled_start") @db.Timestamptz
  playedStatus     String    @map("played_status") @db.VarChar(40)
  scheduleStatus   String    @map("schedule_status") @db.VarChar(40)
  isFinal          Boolean   @default(false) @map("is_final")
  finalObservedAt  DateTime? @map("final_observed_at") @db.Timestamptz
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz

  gameWindow GameWindow? @relation(fields: [gameWindowId], references: [id])

  @@index([season, week], name: "idx_nfl_games_season_week")
  @@map("nfl_games")
}

// The ruleset a season is scored under. Pinned by the first score written; a
// trigger rejects any score row with a different rules_version (§3.4).
model SeasonRules {
  season        String   @id @db.VarChar(20)
  rulesVersion  String   @map("rules_version") @db.VarChar(40)
  pinnedAt      DateTime @map("pinned_at") @db.Timestamptz

  @@map("season_rules")
}

model PlayerGameStats {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  season           String   @db.VarChar(20)
  week             Int      @db.SmallInt
  msfGameId        String   @map("msf_game_id") @db.VarChar(50)
  playerId         String   @map("player_id") @db.VarChar(50)
  gameWindowId     String   @map("game_window_id") @db.Uuid
  passYds          Int      @default(0) @map("pass_yds")
  passTd           Int      @default(0) @map("pass_td") @db.SmallInt
  passInt          Int      @default(0) @map("pass_int") @db.SmallInt
  rushYds          Int      @default(0) @map("rush_yds")
  rushTd           Int      @default(0) @map("rush_td") @db.SmallInt
  receptions       Int      @default(0) @db.SmallInt
  recYds           Int      @default(0) @map("rec_yds")
  recTd            Int      @default(0) @map("rec_td") @db.SmallInt
  returnTd         Int      @default(0) @map("return_td") @db.SmallInt
  fumbleRecTd      Int      @default(0) @map("fumble_rec_td") @db.SmallInt
  fumblesLost      Int      @default(0) @map("fumbles_lost") @db.SmallInt
  twoPt            Int      @default(0) @map("two_pt") @db.SmallInt
  fgMade0To39      Int      @default(0) @map("fg_made_0_39") @db.SmallInt
  fgMade40To49     Int      @default(0) @map("fg_made_40_49") @db.SmallInt
  fgMade50Plus     Int      @default(0) @map("fg_made_50_plus") @db.SmallInt
  fgMissed         Int      @default(0) @map("fg_missed") @db.SmallInt
  xpMade           Int      @default(0) @map("xp_made") @db.SmallInt
  xpMissed         Int      @default(0) @map("xp_missed") @db.SmallInt
  statHash         String   @map("stat_hash") @db.Char(64)
  sourceUpdatedAt  DateTime @map("source_updated_at") @db.Timestamptz
  ingestedAt       DateTime @map("ingested_at") @db.Timestamptz

  gameWindow GameWindow       @relation(fields: [gameWindowId], references: [id])
  score      PlayerGameScore?

  @@unique([season, msfGameId, playerId])
  @@map("player_game_stats")
}

model PlayerGameScore {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statsId        String   @unique @map("stats_id") @db.Uuid
  season         String   @db.VarChar(20)
  week           Int      @db.SmallInt
  msfGameId      String   @map("msf_game_id") @db.VarChar(50)
  playerId       String   @map("player_id") @db.VarChar(50)
  gameWindowId   String   @map("game_window_id") @db.Uuid
  pointsX100     Int      @map("points_x100")
  status         String   @db.VarChar(12)   // provisional | final | frozen
  rulesVersion   String   @map("rules_version") @db.VarChar(40)
  computedAt     DateTime @map("computed_at") @db.Timestamptz

  stats       PlayerGameStats   @relation(fields: [statsId], references: [id])
  gameWindow  GameWindow        @relation(fields: [gameWindowId], references: [id])
  corrections ScoreCorrection[]

  @@unique([season, msfGameId, playerId])
  @@index([season, week, playerId], name: "idx_pgs_player_week")
  @@index([gameWindowId, playerId], name: "idx_pgs_window_player")
  @@map("player_game_scores")
}

// Append-only audit of every change to a Final score (§7).
model ScoreCorrection {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scoreId          String   @map("score_id") @db.Uuid
  detectedAt       DateTime @map("detected_at") @db.Timestamptz
  pointsBeforeX100 Int      @map("points_before_x100")
  pointsAfterX100  Int      @map("points_after_x100")
  statsBefore      Json     @map("stats_before")
  statsAfter       Json     @map("stats_after")
  applied          Boolean
  reason           String   @db.VarChar(30)   // STAT_CORRECTION | AFTER_FREEZE

  score PlayerGameScore @relation(fields: [scoreId], references: [id])

  @@index([scoreId], name: "idx_score_corrections_score")
  @@map("score_corrections")
}

model UserWeekScore {
  userId       String   @map("user_id") @db.Uuid
  season       String   @db.VarChar(20)
  week         Int      @db.SmallInt
  pointsX100   Int      @default(0) @map("points_x100")
  slotsScored  Int      @default(0) @map("slots_scored") @db.SmallInt
  status       String   @db.VarChar(12)   // provisional | final | frozen
  updatedAt    DateTime @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@id([userId, season, week])
  @@index([season, week, pointsX100], name: "idx_user_week_scores_rank")
  @@map("user_week_scores")
}

model WeekFreeze {
  season        String   @db.VarChar(20)
  week          Int      @db.SmallInt
  lastFinalAt   DateTime @map("last_final_at") @db.Timestamptz
  frozenAt      DateTime @map("frozen_at") @db.Timestamptz
  scoresFrozen  Int      @map("scores_frozen")

  @@id([season, week])
  @@map("week_freezes")
}

// ═════════════════════════════════════════════════════════════════════════════
// PRD-003 — Leaderboard
// ═════════════════════════════════════════════════════════════════════════════

model ContestPool {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  season         String   @db.VarChar(20)
  kind           String   @db.VarChar(20)   // season_open | season_closed (P3)
  buyInCents     Int      @map("buy_in_cents")
  name           String   @db.VarChar(80)
  entryClosesAt  DateTime @map("entry_closes_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  // PRD-004 §5: money terms. Frozen once status leaves 'draft' (trigger).
  status         String    @default("draft") @db.VarChar(12)   // draft | open | closed | cancelled | settled
  capacity       Int?
  minEntries     Int?      @map("min_entries")
  rakeBps        Int?      @map("rake_bps")
  prizePoolCents BigInt?   @map("prize_pool_cents")
  paidPlaces     Int?      @map("paid_places")
  minCashCents   BigInt?   @map("min_cash_cents")
  prizeAlgorithm String?   @map("prize_algorithm") @db.VarChar(40)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz

  entries      ContestEntry[]
  snapshots    LeaderboardSnapshot[]
  prizeBands   PrizeTableBand[]
  entryIntents EntryIntent[]
  settlement   Settlement?

  @@unique([season, kind, buyInCents])
  @@map("contest_pools")
}

model ContestEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poolId     String   @map("pool_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  enteredAt  DateTime @map("entered_at") @db.Timestamptz

  pool ContestPool @relation(fields: [poolId], references: [id])
  user User        @relation(fields: [userId], references: [id])
  void ContestEntryVoid?

  @@unique([poolId, userId])
  @@index([userId], name: "idx_contest_entries_user")
  @@map("contest_entries")
}

// Append-only. week_start: written in the week's first lock transaction.
// official: written in the week's freeze transaction.
model LeaderboardSnapshot {
  poolId      String   @map("pool_id") @db.Uuid
  week        Int      @db.SmallInt
  kind        String   @db.VarChar(12)   // week_start | official
  userId      String   @map("user_id") @db.Uuid
  handle      String   @db.VarChar(20)
  rank        Int
  pointsX100  BigInt   @map("points_x100")
  takenAt     DateTime @map("taken_at") @db.Timestamptz

  pool ContestPool @relation(fields: [poolId], references: [id])
  user User        @relation(fields: [userId], references: [id])

  @@id([poolId, week, kind, userId])
  @@map("leaderboard_snapshots")
}

model UserHandleHistory {
  userId     String    @map("user_id") @db.Uuid
  handle     String    @db.VarChar(20)
  season     String    @db.VarChar(20)
  isChange   Boolean   @map("is_change")    // false for the handle set at signup
  validFrom  DateTime  @map("valid_from") @db.Timestamptz
  validTo    DateTime? @map("valid_to") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@id([userId, validFrom])
  @@index([season, userId], name: "idx_handle_history_season_user")
  @@map("user_handle_history")
}

// ═════════════════════════════════════════════════════════════════════════════
// PRD-004 — Payments
// All money is integer cents. No table stores a card number, bank account
// number, SSN or TIN: only processor / provider references (AC19).
// ═════════════════════════════════════════════════════════════════════════════

// Published prize table. Immutable once the pool leaves 'draft' (trigger).
model PrizeTableBand {
  poolId      String @map("pool_id") @db.Uuid
  fromPlace   Int    @map("from_place")
  toPlace     Int    @map("to_place")
  prizeCents  BigInt @map("prize_cents")

  pool ContestPool @relation(fields: [poolId], references: [id])

  @@id([poolId, fromPlace])
  @@map("prize_table_bands")
}

// A checkout attempt. A pending intent with an unexpired hold reserves a seat.
model EntryIntent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  poolId         String    @map("pool_id") @db.Uuid
  amountCents    Int       @map("amount_cents")
  rakeCents      Int       @map("rake_cents")
  status         String    @db.VarChar(12)   // pending | expired | failed | captured | refunded
  holdExpiresAt  DateTime  @map("hold_expires_at") @db.Timestamptz
  processor      String    @db.VarChar(20)
  checkoutRef    String?   @map("checkout_ref") @db.VarChar(255)
  paymentRef     String?   @unique @map("payment_ref") @db.VarChar(255)
  ipRegion       String    @map("ip_region") @db.VarChar(10)
  billingRegion  String    @map("billing_region") @db.VarChar(10)
  createdAt      DateTime  @map("created_at") @db.Timestamptz
  capturedAt     DateTime? @map("captured_at") @db.Timestamptz

  user User        @relation(fields: [userId], references: [id])
  pool ContestPool @relation(fields: [poolId], references: [id])

  @@index([poolId, status], name: "idx_entry_intents_pool_status")
  @@index([userId], name: "idx_entry_intents_user")
  @@map("entry_intents")
}

// Append-only. A voided entry is excluded from boards and snapshots (PRD-003).
model ContestEntryVoid {
  entryId   String   @id @map("entry_id") @db.Uuid
  reason    String   @db.VarChar(30)
  voidedAt  DateTime @map("voided_at") @db.Timestamptz
  voidedBy  String?  @map("voided_by") @db.Uuid

  entry ContestEntry @relation(fields: [entryId], references: [id])

  @@map("contest_entry_voids")
}

model Refund {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  intentId     String?   @map("intent_id") @db.Uuid
  paymentRef   String    @unique @map("payment_ref") @db.VarChar(255)
  amountCents  Int       @map("amount_cents")
  prizeShareCents Int    @default(0) @map("prize_share_cents") // part returned from processor_clearing:prize
  reason       String    @db.VarChar(30)
  status       String    @db.VarChar(12)   // pending | succeeded
  refundRef    String?   @unique @map("refund_ref") @db.VarChar(255)
  createdAt    DateTime  @map("created_at") @db.Timestamptz
  succeededAt  DateTime? @map("succeeded_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("refunds")
}

model ProcessorEvent {
  processor    String    @db.VarChar(20)
  eventId      String    @map("event_id") @db.VarChar(255)
  type         String    @db.VarChar(30)
  payload      Json
  receivedAt   DateTime  @map("received_at") @db.Timestamptz
  processedAt  DateTime? @map("processed_at") @db.Timestamptz

  @@id([processor, eventId])
  @@index([processedAt, receivedAt], name: "idx_processor_events_pending")
  @@map("processor_events")
}

// Written approval for a processor to move live money (§7.3). Append-only.
model ProcessorApproval {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  processor    String   @db.VarChar(20)
  approvedAt   DateTime @map("approved_at") @db.Timestamptz
  documentRef  String   @map("document_ref") @db.VarChar(255)
  recordedBy   String   @map("recorded_by") @db.Uuid

  @@map("processor_approvals")
}

model LedgerAccount {
  code    String  @id @db.VarChar(80)
  kind    String  @db.VarChar(12)   // asset | liability | revenue | expense
  poolId  String? @map("pool_id") @db.Uuid
  userId  String? @map("user_id") @db.Uuid

  entries LedgerEntry[]

  @@map("ledger_accounts")
}

// Append-only. Each transaction's entries sum to zero (deferred trigger).
model LedgerTransaction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind            String   @db.VarChar(30)
  refType         String   @map("ref_type") @db.VarChar(30)
  refId           String   @map("ref_id") @db.VarChar(255)
  idempotencyKey  String   @unique @map("idempotency_key") @db.VarChar(255)
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz
  postedAt        DateTime @default(now()) @map("posted_at") @db.Timestamptz

  entries LedgerEntry[]

  @@index([refType, refId], name: "idx_ledger_txn_ref")
  @@map("ledger_transactions")
}

model LedgerEntry {
  id           BigInt @id @default(autoincrement())
  txnId        String @map("txn_id") @db.Uuid
  account      String @db.VarChar(80)
  amountCents  BigInt @map("amount_cents")   // debit positive, credit negative

  txn         LedgerTransaction @relation(fields: [txnId], references: [id])
  accountRef  LedgerAccount     @relation(fields: [account], references: [code])

  @@index([account], name: "idx_ledger_entries_account")
  @@index([txnId], name: "idx_ledger_entries_txn")
  @@map("ledger_entries")
}

model Settlement {
  poolId        String    @id @map("pool_id") @db.Uuid
  snapshotWeek  Int       @map("snapshot_week") @db.SmallInt
  status        String    @db.VarChar(12)   // computed | approved
  computedAt    DateTime  @map("computed_at") @db.Timestamptz
  approvedBy    String?   @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz

  pool   ContestPool       @relation(fields: [poolId], references: [id])
  awards SettlementAward[]

  @@map("settlements")
}

// Immutable once written.
model SettlementAward {
  poolId       String @map("pool_id") @db.Uuid
  entryId      String @map("entry_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid
  rank         Int
  tieSize      Int    @map("tie_size")
  amountCents  BigInt @map("amount_cents")

  settlement Settlement @relation(fields: [poolId], references: [poolId])

  @@id([poolId, entryId])
  @@index([userId], name: "idx_settlement_awards_user")
  @@map("settlement_awards")
}

model PayoutAccount {
  userId           String   @id @map("user_id") @db.Uuid
  processor        String   @db.VarChar(20)
  accountRef       String   @map("account_ref") @db.VarChar(255)
  payoutsEnabled   Boolean  @map("payouts_enabled")
  tinVerified      Boolean  @map("tin_verified")
  instantEligible  Boolean  @map("instant_eligible")
  updatedAt        DateTime @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("payout_accounts")
}

model Payout {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  poolId          String    @map("pool_id") @db.Uuid
  attempt         Int
  amountCents     BigInt    @map("amount_cents")
  feeCents        BigInt    @default(0) @map("fee_cents")
  speed           String    @db.VarChar(10)   // standard | instant
  status          String    @db.VarChar(10)   // pending | sent | paid | failed
  payoutRef       String?   @unique @map("payout_ref") @db.VarChar(255)
  idempotencyKey  String    @unique @map("idempotency_key") @db.VarChar(255)
  failureReason   String?   @map("failure_reason") @db.VarChar(255)
  createdAt       DateTime  @map("created_at") @db.Timestamptz
  sentAt          DateTime? @map("sent_at") @db.Timestamptz
  paidAt          DateTime? @map("paid_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([poolId, userId, attempt])
  @@index([status], name: "idx_payouts_status")
  @@map("payouts")
}

model AccountHold {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  reason    String    @db.VarChar(30)   // DISPUTE | ADMIN
  refId     String?   @map("ref_id") @db.VarChar(255)
  openedAt  DateTime  @map("opened_at") @db.Timestamptz
  closedAt  DateTime? @map("closed_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, closedAt], name: "idx_account_holds_user_open")
  @@map("account_holds")
}

// Status and references only: never ID numbers or images (§11.1).
model IdentityVerification {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(30)
  providerRef    String   @map("provider_ref") @db.VarChar(255)
  personHash     String   @map("person_hash") @db.Char(64)
  status         String   @db.VarChar(12)   // verified | rejected | revoked
  verifiedRegion String   @map("verified_region") @db.VarChar(10)
  birthDate      DateTime @map("birth_date") @db.Date
  verifiedAt     DateTime @map("verified_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId], name: "idx_identity_verifications_user")
  @@map("identity_verifications")
}

model Jurisdiction {
  country        String    @db.VarChar(2)
  region         String    @db.VarChar(10)
  subRegion      String    @default("") @map("sub_region") @db.VarChar(60)
  status         String    @db.VarChar(10)   // allowed | blocked
  minAge         Int       @map("min_age") @db.SmallInt
  effectiveFrom  DateTime  @map("effective_from") @db.Timestamptz
  effectiveTo    DateTime? @map("effective_to") @db.Timestamptz
  sourceNote     String    @map("source_note")

  @@id([country, region, subRegion, effectiveFrom])
  @@map("jurisdictions")
}

model TaxThreshold {
  taxYear         Int    @map("tax_year") @db.SmallInt
  form            String @db.VarChar(20)
  thresholdCents  BigInt @map("threshold_cents")

  @@id([taxYear, form])
  @@map("tax_thresholds")
}

model BankReconciliation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account        String   @db.VarChar(80)
  statementDate  DateTime @map("statement_date") @db.Date
  balanceCents   BigInt   @map("balance_cents")
  enteredBy      String   @map("entered_by") @db.Uuid
  enteredAt      DateTime @map("entered_at") @db.Timestamptz

  @@map("bank_reconciliations")
}
